# Supabase — create a project at https://supabase.com then paste values into .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here (server only, for seed scripts)

# Optional — contact form fallback (if you want email notifications)
# RESEND_API_KEY=
